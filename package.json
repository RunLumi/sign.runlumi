{
	"name": "signmos",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"prepare": "simple-git-hooks",
		"init-project": "tsx scripts/init-project.ts",
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"deploy": "./scripts/deploy-production.sh --deploy",
		"serve": "vite preview",
		"cf-typegen": "wrangler types --env-interface BaseEnv",
		"secrets:sync:dev": "./sync-secrets.sh dev",
		"secrets:sync:staging": "./sync-secrets.sh staging",
		"secrets:sync:production": "./sync-secrets.sh production",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"agentic:calibrate": "node --import tsx scripts/agentic-calibrate.ts",
		"agentic:smoke": "node --import tsx scripts/agentic-smoke.ts",
		"types": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:ci": "biome ci .",
		"knip": "knip",
		"release": "semantic-release",
		"release:dry": "semantic-release --dry-run",
		"deps": "taze -r",
		"deps:update": "taze -r -w",
		"deps:major": "taze -r major",
		"deps:major:update": "taze -r major -w",
		"db:generate:dev": "drizzle-kit generate --config drizzle-d1.config.ts",
		"db:generate:staging": "drizzle-kit generate --config drizzle-d1.config.ts",
		"db:generate:production": "drizzle-kit generate --config drizzle-d1.config.ts",
		"db:migrate:dev": "wrangler d1 migrations apply signmos-dev --local",
		"db:migrate:staging": "wrangler d1 migrations apply signmos-staging --remote --env staging",
		"db:migrate:production": "wrangler d1 migrations apply signmos-production --remote --env production",
		"db:seed:dev": "tsx scripts/seed.ts",
		"e2e:placement": "node scripts/e2e/multipage-placement.mjs",
		"email:preview": "node --import tsx scripts/email-previews.ts",
		"e2e:brand": "node scripts/e2e/brand-surfaces.mjs",
		"e2e:storage": "node scripts/e2e/signed-pdf-storage.mjs"
	},
	"dependencies": {
		"@pdf-lib/fontkit": "1.1.1",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-slot": "^1.3.3",
		"@tabler/icons-react": "3.35.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-form": "^1.33.4",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-query-devtools": "^5.101.4",
		"@tanstack/react-router": "^1.170.23",
		"@tanstack/react-router-devtools": "^1.167.0",
		"@tanstack/react-router-ssr-query": "^1.167.1",
		"@tanstack/react-start": "^1.168.40",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"fflate": "0.8.2",
		"hono": "^4.13.1",
		"lucide-react": "^1.30.0",
		"pdf-lib": "^1.17.1",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"vite-tsconfig-paths": "^6.1.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"@cloudflare/vite-plugin": "^1.51.1",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^5.2.0",
		"@vitest/coverage-v8": "^4.1.10",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^29.1.1",
		"knip": "^6.32.0",
		"playwright": "1.62.1",
		"semantic-release": "^25.0.9",
		"simple-git-hooks": "^2.13.1",
		"taze": "^19.17.2",
		"tsx": "^4.23.11",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vitest": "^4.1.10",
		"web-vitals": "^5.3.0",
		"wrangler": "^4.120.0"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm run lint:ci",
		"pre-push": "pnpm run types && pnpm run knip"
	}
}
