{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "signmos",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"main": "./src/server.ts",
	"r2_buckets": [
		{
			"binding": "DOCUMENTS_BUCKET",
			"bucket_name": "signmos-documents-dev"
		}
	],
	"env": {
		"staging": {
			"name": "signmos-staging",
			"r2_buckets": [
				{
					"binding": "DOCUMENTS_BUCKET",
					"bucket_name": "signmos-documents-staging"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "signmos-staging",
					"migrations_dir": "src/db/migrations/d1"
				}
			],
			"send_email": [
				{
					"name": "EMAIL"
				}
			],
			"vars": {
				"CLOUDFLARE_ENV": "dev",
				"APP_BASE_URL": "https://signmos-staging.workers.dev",
				"EMAIL_FROM": "Lumi Sign <sign@runlumi.app>",
				"EMAIL_REPLY_TO": "sign@runlumi.app",
				"TURNSTILE_DISABLED": "true"
			}
		},
		"production": {
			"name": "signmos-production",
			"workers_dev": false,
			"preview_urls": false,
			"routes": [
				{
					"pattern": "sign.runlumi.app",
					"custom_domain": true
				}
			],
			"r2_buckets": [
				{
					"binding": "DOCUMENTS_BUCKET",
					"bucket_name": "signmos-documents-production"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "signmos-production",
					"database_id": "76c5b134-6582-43e3-97c0-c144e4420259",
					"migrations_dir": "src/db/migrations/d1"
				}
			],
			"send_email": [
				{
					"name": "EMAIL"
				}
			],
			"vars": {
				"CLOUDFLARE_ENV": "production",
				"APP_BASE_URL": "https://sign.runlumi.app",
				"EMAIL_FROM": "Lumi Sign <sign@runlumi.app>",
				"EMAIL_REPLY_TO": "sign@runlumi.app",
				"TURNSTILE_DISABLED": "true"
			}
		}
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "signmos-dev",
			"migrations_dir": "src/db/migrations/d1"
		}
	],
	"vars": {
		"CLOUDFLARE_ENV": "dev",
		"APP_BASE_URL": "http://localhost:3000",
		"TURNSTILE_DISABLED": "true"
	}
}
